<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LabangOnline" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary brand color (green) -->
        <item name="colorPrimary">@color/labang_green</item>
        <item name="colorPrimaryVariant">@color/labang_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary color -->
        <item name="colorSecondary">@color/labang_green</item>
        <item name="colorSecondaryVariant">@color/labang_green_dark</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar dark -->
        <item name="android:statusBarColor">@color/bg_secondary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text Input style -->
        <item name="textInputStyle">@style/LabangTextInputStyle</item>
    </style>

    <!-- TextInputLayout Style -->
    <style name="LabangTextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxStrokeColor">@color/labang_green</item>
        <item name="hintTextColor">@color/text_muted</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>

    <!-- MaterialButton primary (green filled) -->
    <style name="LabangButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/labang_green</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- MaterialButton outlined (green border) -->
    <style name="LabangButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/bg_card</item>
        <item name="android:textColor">@color/labang_green</item>
        <item name="strokeColor">@color/labang_green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>