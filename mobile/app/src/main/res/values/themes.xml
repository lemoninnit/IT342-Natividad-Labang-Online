<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LabangOnline" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/labang_green</item>
        <item name="colorPrimaryVariant">@color/labang_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/labang_green</item>
        <item name="colorSecondaryVariant">@color/labang_green_dark</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_primary</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <!-- Disable Activity window transition animations -->
        <item name="android:windowAnimationStyle">@style/Animation.Activity.NoAnimation</item>
        <!-- Default text and hint colors globally -->
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="Animation.Activity.NoAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <!-- MaterialButton styles -->
    <style name="LabangButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/labang_green</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LabangButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/labang_green</item>
        <item name="strokeColor">@color/labang_green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RegisterLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="RegisterInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="boxBackgroundMode">outline</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintEnabled">false</item>
        <item name="boxStrokeColor">@color/border_subtle</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="errorTextColor">@color/status_error</item>
        <item name="errorIconTint">@color/status_error</item>
        <item name="helperTextTextAppearance">@style/HelperTextAppearance</item>
    </style>

    <style name="HelperTextAppearance" parent="TextAppearance.AppCompat.Small">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.LabangOnline.DatePicker" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/labang_green</item>
        <item name="colorAccent">@color/labang_green</item>
        <item name="android:windowBackground">@color/bg_card</item>
        <item name="android:textColorPrimary">#ffffff</item>
        <item name="android:textColorSecondary">#94a3b8</item>
        <item name="android:numbersBackgroundColor">#111827</item>
        <item name="android:numbersTextColor">#ffffff</item>
    </style>
</resources>
