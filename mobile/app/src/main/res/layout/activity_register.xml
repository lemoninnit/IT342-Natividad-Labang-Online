<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b1020"
    tools:context=".auth.RegisterActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ── Header ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create Your Account"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#e2e8f0"
                    android:fontFamily="sans-serif-medium" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="#10b981" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register as a Barangay Labangon resident"
                    android:textSize="13sp"
                    android:textColor="#64748b"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ── Error Message ── -->
            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#ef4444"
                android:textSize="13sp"
                android:background="@drawable/error_bg"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- ══════════════════════════════════════ -->
            <!-- CARD 1 — Personal Information          -->
            <!-- ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1e293b"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="18dp"
                            android:background="#10b981"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Personal Information"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#e2e8f0" />
                    </LinearLayout>

                    <!-- First Name & Middle Name (side by side) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <!-- First Name -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="First Name *"
                                android:textSize="12sp"
                                android:textColor="#94a3b8"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="#0f172a"
                                app:boxBackgroundMode="filled"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusTopStart="10dp"
                                app:hintEnabled="false"
                                app:boxStrokeColor="#10b981"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/firstNameInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="e.g. Juan"
                                    android:inputType="textPersonName"
                                    android:maxLines="1"
                                    android:textColor="#e2e8f0"
                                    android:textColorHint="#334155"
                                    android:padding="13dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <!-- Middle Name -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Middle Name"
                                android:textSize="12sp"
                                android:textColor="#94a3b8"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="#0f172a"
                                app:boxBackgroundMode="filled"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusTopStart="10dp"
                                app:hintEnabled="false"
                                app:boxStrokeColor="#10b981"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/middleNameInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Optional"
                                    android:inputType="textPersonName"
                                    android:maxLines="1"
                                    android:textColor="#e2e8f0"
                                    android:textColorHint="#334155"
                                    android:padding="13dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Last Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Name *"
                        android:textSize="12sp"
                        android:textColor="#94a3b8"
                        android:textStyle="bold"
                        android:layout_marginBottom="5dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="#0f172a"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintEnabled="false"
                        app:boxStrokeColor="#10b981"
                        app:boxStrokeWidth="1dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/lastNameInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g. Dela Cruz"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:textColor="#e2e8f0"
                            android:textColorHint="#334155"
                            android:padding="13dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Date of Birth & Gender (side by side) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Date of Birth -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date of Birth *"
                                android:textSize="12sp"
                                android:textColor="#94a3b8"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="#0f172a"
                                app:boxBackgroundMode="filled"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusTopStart="10dp"
                                app:hintEnabled="false"
                                app:boxStrokeColor="#10b981"
                                app:boxStrokeWidth="1dp"
                                app:endIconMode="custom"
                                app:endIconDrawable="@android:drawable/ic_menu_today"
                                app:endIconTint="#64748b">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/dobInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="mm/dd/yyyy"
                                    android:inputType="none"
                                    android:focusable="false"
                                    android:clickable="true"
                                    android:maxLines="1"
                                    android:textColor="#e2e8f0"
                                    android:textColorHint="#334155"
                                    android:padding="13dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <!-- Gender -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gender"
                                android:textSize="12sp"
                                android:textColor="#94a3b8"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp" />

                            <!-- Spinner styled to match inputs -->
                            <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/genderSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:background="@drawable/spinner_bg"
                                android:paddingStart="13dp"
                                android:paddingEnd="13dp"
                                android:textColor="#e2e8f0"
                                android:popupBackground="#1e293b" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════ -->
            <!-- CARD 2 — Address & Contact             -->
            <!-- ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#1e293b"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="18dp"
                            android:background="#10b981"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Address &amp; Contact"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#e2e8f0" />
                    </LinearLayout>

                    <!-- Labangon Notice Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/notice_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📍"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Registration is exclusively for Barangay Labangon residents."
                            android:textSize="12sp"
                            android:textColor="#94a3b8"
                            android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <!-- House No. / Street -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="House No. / Street *"
                        android:textSize="12sp"
                        android:textColor="#94a3b8"
                        android:textStyle="bold"
                        android:layout_marginBottom="5dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="#0f172a"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintEnabled="false"
                        app:boxStrokeColor="#10b981"
                        app:boxStrokeWidth="1dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/streetInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="e.g. 123 Mabini St."
                            android:inputType="textPostalAddress"
                            android:maxLines="1"
                            android:textColor="#e2e8f0"
                            android:textColorHint="#334155"
                            android:padding="13dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Purok & Barangay (side by side) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <!-- Purok -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Purok *"
                                android:textSize="12sp"
                                android:textColor="#94a3b8"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="#0f172a"
                                app:boxBackgroundMode="filled"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusTopStart="10dp"
                                app:hintEnabled="false"
                                app:boxStrokeColor="#10b981"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/purokInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="e.g. Purok 3"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:textColor="#e2e8f0"
                                    android:textColorHint="#334155"
                                    android:padding="13dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <!-- Barangay -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Barangay *"
                                android:textSize="12sp"
                                android:textColor="#94a3b8"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="#0f172a"
                                app:boxBackgroundMode="filled"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusTopStart="10dp"
                                app:hintEnabled="false"
                                app:boxStrokeColor="#10b981"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/barangayInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Labangon"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:textColor="#e2e8f0"
                                    android:textColorHint="#334155"
                                    android:padding="13dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- City & Province (side by side) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <!-- City -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="City"
                                android:textSize="12sp"
                                android:textColor="#94a3b8"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="#0f172a"
                                app:boxBackgroundMode="filled"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusTopStart="10dp"
                                app:hintEnabled="false"
                                app:boxStrokeColor="#10b981"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/cityInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cebu City"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:textColor="#e2e8f0"
                                    android:textColorHint="#334155"
                                    android:padding="13dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <!-- Province -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Province"
                                android:textSize="12sp"
                                android:textColor="#94a3b8"
                                android:textStyle="bold"
                                android:layout_marginBottom="5dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxBackgroundColor="#0f172a"
                                app:boxBackgroundMode="filled"
                                app:boxCornerRadiusBottomEnd="10dp"
                                app:boxCornerRadiusBottomStart="10dp"
                                app:boxCornerRadiusTopEnd="10dp"
                                app:boxCornerRadiusTopStart="10dp"
                                app:hintEnabled="false"
                                app:boxStrokeColor="#10b981"
                                app:boxStrokeWidth="1dp">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/provinceInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cebu"
                                    android:inputType="text"
                                    android:maxLines="1"
                                    android:textColor="#e2e8f0"
                                    android:textColorHint="#334155"
                                    android:padding="13dp" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Mobile Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile Number *"
                        android:textSize="12sp"
                        android:textColor="#94a3b8"
                        android:textStyle="bold"
                        android:layout_marginBottom="5dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxBackgroundColor="#0f172a"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintEnabled="false"
                        app:boxStrokeColor="#10b981"
                        app:boxStrokeWidth="1dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="09XXXXXXXXX"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:textColor="#e2e8f0"
                            android:textColorHint="#334155"
                            android:padding="13dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email Address -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address *"
                        android:textSize="12sp"
                        android:textColor="#94a3b8"
                        android:textStyle="bold"
                        android:layout_marginBottom="5dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundColor="#0f172a"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintEnabled="false"
                        app:boxStrokeColor="#10b981"
                        app:boxStrokeWidth="1dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/emailInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="yourname@email.com"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:textColor="#e2e8f0"
                            android:textColorHint="#334155"
                            android:padding="13dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════ -->
            <!-- CARD 3 — Security                      -->
            <!-- ══════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#1e293b"
                app:cardElevation="0dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Section Label -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="3dp"
                            android:layout_height="18dp"
                            android:background="#10b981"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Security"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#e2e8f0" />
                    </LinearLayout>

                    <!-- Encryption Notice -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/notice_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Your password is encrypted using BCrypt before saving."
                            android:textSize="12sp"
                            android:textColor="#94a3b8"
                            android:lineSpacingMultiplier="1.4" />
                    </LinearLayout>

                    <!-- Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password *"
                        android:textSize="12sp"
                        android:textColor="#94a3b8"
                        android:textStyle="bold"
                        android:layout_marginBottom="5dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        app:boxBackgroundColor="#0f172a"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintEnabled="false"
                        app:boxStrokeColor="#10b981"
                        app:boxStrokeWidth="1dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#64748b">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/passwordInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Min. 8 characters"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="#e2e8f0"
                            android:textColorHint="#334155"
                            android:padding="13dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Hints -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/hintLength"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="○ At least 8 characters"
                            android:textSize="11sp"
                            android:textColor="#475569" />

                        <TextView
                            android:id="@+id/hintUpper"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="○ One uppercase letter"
                            android:textSize="11sp"
                            android:textColor="#475569" />

                        <TextView
                            android:id="@+id/hintNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="○ One number"
                            android:textSize="11sp"
                            android:textColor="#475569" />
                    </LinearLayout>

                    <!-- Confirm Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirm Password *"
                        android:textSize="12sp"
                        android:textColor="#94a3b8"
                        android:textStyle="bold"
                        android:layout_marginBottom="5dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:boxBackgroundColor="#0f172a"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:hintEnabled="false"
                        app:boxStrokeColor="#10b981"
                        app:boxStrokeWidth="1dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#64748b">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/confirmPasswordInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Re-enter password"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="#e2e8f0"
                            android:textColorHint="#334155"
                            android:padding="13dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Terms & Conditions Checkbox -->
                    <CheckBox
                        android:id="@+id/agreeTermsCheckbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="I agree to the Terms and Conditions and Privacy Policy."
                        android:textSize="13sp"
                        android:textColor="#94a3b8"
                        android:buttonTint="#10b981"
                        android:layout_marginBottom="8dp" />

                    <!-- Loading -->
                    <ProgressBar
                        android:id="@+id/loadingIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp"
                        android:indeterminateTint="#10b981" />

                    <!-- Register Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/registerButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Create Account"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:letterSpacing="0.05"
                        app:backgroundTint="#10b981"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Back to Login ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Back to Sign In"
                android:textSize="14sp"
                android:textColor="#94a3b8"
                app:backgroundTint="#1e293b"
                app:cornerRadius="10dp"
                app:strokeColor="#334155"
                app:strokeWidth="1dp" />

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="© 2026 Barangay Labangon • LabangOnline"
                android:textSize="11sp"
                android:textColor="#334155"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>