<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".auth.RegisterActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── Header ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create your account"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register as a resident of Barangay Labangon"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- ── Error Alert (Banner) ── -->
            <LinearLayout
                android:id="@+id/errorBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/error_bg"
                android:padding="14dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:id="@+id/errorBannerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Registration failed. Please try again."
                    android:textColor="#fca5a5"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ── Form Card ── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#2d3748">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Row 1: First Name + Last Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="First name" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/firstNameLayout"
                                style="@style/RegisterInputLayout">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/firstNameInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Juan"
                                    android:inputType="textPersonName"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Last name" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/lastNameLayout"
                                style="@style/RegisterInputLayout">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/lastNameInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Dela Cruz"
                                    android:inputType="textPersonName"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 2: Middle Name + Username -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Middle name (optional)" />

                            <com.google.android.material.textfield.TextInputLayout style="@style/RegisterInputLayout">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/middleNameInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Santos"
                                    android:inputType="textPersonName"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Username" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/usernameLayout"
                                style="@style/RegisterInputLayout">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/usernameInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="juandelacruz"
                                    android:inputType="text"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 3: Email + Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Email" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/emailLayout"
                                style="@style/RegisterInputLayout"
                                app:helperText="We will send a 6-digit code">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/emailInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="juan.delacruz@email.com"
                                    android:inputType="textEmailAddress"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Phone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/phoneLayout"
                                style="@style/RegisterInputLayout"
                                app:helperText="Philippine mobile number (+63)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/phoneInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="phone"
                                    android:padding="16dp"
                                    android:text="+63"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 4: DOB + Civil Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Date of birth" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/dobLayout"
                                style="@style/RegisterInputLayout"
                                app:endIconDrawable="@drawable/ic_calendar"
                                app:endIconMode="custom"
                                app:endIconTint="@color/text_muted">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/dobInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="false"
                                    android:hint="mm/dd/yyyy"
                                    android:inputType="none"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Civil Status" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/civilStatusLayout"
                                style="@style/RegisterInputLayout"
                                app:endIconMode="dropdown_menu"
                                app:endIconTint="@color/text_muted">

                                <AutoCompleteTextView
                                    android:id="@+id/civilStatusInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@null"
                                    android:hint="Single"
                                    android:inputType="none"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 5: Address line + Purok -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Address line" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/addressLayout"
                                style="@style/RegisterInputLayout"
                                app:helperText="Street, house number, etc.">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/addressInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="123 Mabuhay Street"
                                    android:inputType="textPostalAddress"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Purok" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/purokLayout"
                                style="@style/RegisterInputLayout">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/purokInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Purok 5"
                                    android:inputType="text"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 6: Barangay + City -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Barangay" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/RegisterInputLayout"
                                android:enabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/barangayInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:padding="16dp"
                                    android:text="Labangon"
                                    android:textColor="@color/text_muted" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="City" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/RegisterInputLayout"
                                android:enabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/cityInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:padding="16dp"
                                    android:text="Cebu City"
                                    android:textColor="@color/text_muted" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 7: Province + Postal Code -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Province" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/RegisterInputLayout"
                                android:enabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/provinceInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:padding="16dp"
                                    android:text="Cebu"
                                    android:textColor="@color/text_muted" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Postal code" />

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/RegisterInputLayout"
                                android:enabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/postalCodeInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:padding="16dp"
                                    android:text="6000"
                                    android:textColor="@color/text_muted" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Row 8: Password + Confirm Password -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Password" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/passwordLayout"
                                style="@style/RegisterInputLayout"
                                app:helperText="Minimum 8 characters"
                                app:passwordToggleEnabled="true"
                                app:passwordToggleTint="@color/text_muted">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/passwordInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Enter at least 8 characters"
                                    android:inputType="textPassword"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/RegisterLabel"
                                android:text="Confirm password" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/confirmPasswordLayout"
                                style="@style/RegisterInputLayout"
                                app:passwordToggleEnabled="true"
                                app:passwordToggleTint="@color/text_muted">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/confirmPasswordInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Re-enter password"
                                    android:inputType="textPassword"
                                    android:padding="16dp"
                                    android:textColor="@color/text_primary" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Verification Notice Box -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="32dp"
                        app:cardBackgroundColor="#0f172a"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#1a3d31"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:text="📋"
                                android:textSize="18sp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Account Verification Required"
                                    android:textColor="@color/labang_green"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:lineSpacingMultiplier="1.4"
                                    android:text="Important: Your account will be created with a pending status. Visit the Barangay Hall with a valid ID to activate your account."
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/registerButton"
                            style="@style/LabangButton.Primary"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1.2"
                            android:text="Create account" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/backButton"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="Already have an account? →"
                            android:textAllCaps="false"
                            android:textColor="@color/labang_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:indeterminateTint="@color/labang_green"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
